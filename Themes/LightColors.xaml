<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#FFDEDEDE"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1A86D8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF005A9E"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#FF999999"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#FFD0D0D0"/>

</ResourceDictionary>
